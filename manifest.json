{
  "manifest_version": 3,
  "name": "Scroll Freeze for X",
  "version": "1.0.0",
  "description": "Limits tweets to 40 per page and disables infinite scroll on Twitter/X",
  "permissions": [],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
